# Supabase (публичные ключи — только для клиента)
VITE_SUPABASE_URL=https://yxxwpsodzksvxpvizybt.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Если в Supabase Auth включено подтверждение email,
# после регистрации пользователь получит письмо и сможет войти после подтверждения.

# Cloudflare R2 — секреты только в Supabase Edge Function secrets (НЕ в .env клиента):
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=...
# R2_PUBLIC_BASE_URL=https://files.example.com

# AnyModel + Edge Function anymodel-chat — только в Supabase Edge Function secrets (НЕ в .env клиента):
# ANYMODEL_API_KEY=your-anymodel-api-key
# ANYMODEL_BASE_URL=https://anymodel.org/v1
# ANYMODEL_MODEL=cx/gpt-5.6-luna
# SUPABASE_URL=https://yxxwpsodzksvxpvizybt.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
